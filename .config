#
# Phicomm K3 (BCM4709C0 / bcm53xx / ARM Cortex-A9) — daed 固件种子配置
#
# 这是一份「种子 config」，只写死关键选项，其余交给 `make defconfig` 补全。
# 好处是上游改动时不会像 700 行完整 config 那样大面积失效。
#
# 改配置的正确姿势：本地 `make menuconfig` 调完后，用 `./scripts/diffconfig.sh`
# 导出差异，再把结果覆盖到本文件 —— 不要直接提交 defconfig 生成的完整 .config。
#

#
# 目标设备
#
CONFIG_TARGET_bcm53xx=y
CONFIG_TARGET_bcm53xx_generic=y
CONFIG_TARGET_bcm53xx_generic_DEVICE_phicomm_k3=y

#
# eBPF / BTF —— daed 的硬性前提，缺一不可
#
# daed 走 eBPF CO-RE，运行时必须能读到 /sys/kernel/btf/vmlinux。
# bcm53xx 不在 KERNEL_DEBUG_INFO_BTF 的 default y 列表里，所以必须手动开。
# KERNEL_DEBUG_INFO_BTF 会 select DWARVES（自动构建 pahole）。
#
CONFIG_DEVEL=y
CONFIG_BPF_TOOLCHAIN_HOST=y
CONFIG_BPF_TOOLCHAIN_HOST_PATH=""
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_DEBUG_FS=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_XDP_SOCKETS=y

#
# daed
#
# luci-app-daed 会自动带入 daed / daed-geoip / daed-geosite /
# kmod-sched-core / kmod-sched-bpf / kmod-xdp-sockets-diag / kmod-veth，
# 所以这里只需要一行。
#
CONFIG_PACKAGE_luci-app-daed=y

#
# homebox 网络测速工具箱（由 diy-part2.sh 从 jjm2473/openwrt-apps 提取）
#
CONFIG_PACKAGE_luci-app-homebox=y

#
# TCP BBR
#
# 注意：不装 luci-app-turboacc。它的 Flow Offloading 会与 daed 的 eBPF
# 转发路径冲突，Shortcut-FE 是高通平台的东西（K3 是 Broadcom，无硬件 NAT
# 加速驱动）。只有 BBR 这一项对 daed 的出站代理链路是真有用的，单独装。
#
CONFIG_PACKAGE_kmod-tcp-bbr=y

#
# LuCI
#
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_LUCI_LANG_zh_Hans=y

#
# 常用命令行工具
#
# 包名陷阱（都已核对过 feed，别想当然）：
#   wget    -> 无此包，只有 wget-ssl / wget-nossl
#   mtr     -> 无此包，只有 mtr-json / mtr-nojson
#   bpftool -> 无此包，只有 bpftool-minimal（默认变体）/ bpftool-full
#   zip / diffutils -> feed 里根本没有
#   coreutils -> 是带 MENU:=1 的空壳菜单包，真正的命令在 coreutils-* 子包里
# 写错的话 make defconfig 会静默改成 n，固件编出来才发现少东西。
#
# busybox 已经提供了绝大多数基础命令，这里只补它没有或功能残缺的。
#
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_less=y
CONFIG_PACKAGE_file=y
CONFIG_PACKAGE_lsof=y
CONFIG_PACKAGE_findutils=y
CONFIG_PACKAGE_gzip=y
CONFIG_PACKAGE_unzip=y

# GNU tar 的连锁依赖，三个都得显式写，缺一个 tar 就整个从 kconfig 里消失：
#   1. tar 的 PACKAGE_TAR_XZ 默认为 y（USE_FS_ACL_ATTR 在 bcm53xx 上也是 y，
#      连带 TAR_POSIX_ACL / TAR_XATTR 也是 y），于是 tar 依赖 xz 包
#   2. xz 包写的是 `DEPENDS:=xz-utils +liblzma` —— xz-utils 没有 + 前缀，
#      是硬依赖；而 xz-utils 是空壳 meta 包（install 里就一句 true）
#   3. kconfig 的 select 不会自动满足被选中项的 depends，所以 xz-utils 不选，
#      xz 就不可见，tar 依赖不可见 symbol，自己也被隐藏
# 症状很隐蔽：.config 里连 `# CONFIG_PACKAGE_tar is not set` 都不会出现，
# 只剩下一堆 CONFIG_PACKAGE_TAR_*=y 子选项，看着像配置生效了。
# 顺带 xz 包还提供 xz/unxz/xzcat/lzma/unlzma/lzcat，本来就该装。
CONFIG_PACKAGE_xz-utils=y
CONFIG_PACKAGE_xz=y
CONFIG_PACKAGE_tar=y

#
# 网络排查（daed 出问题时全靠这些）
#
# ip-full：busybox 的 ip 命令很残，看不了 tc/规则表，而 daed 正是挂在 tc 层
# tcpdump-mini：比完整版小得多，抓包排查够用
# bind-dig：daed 场景 DNS 问题高频
#
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_mtr-json=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_bpftool-minimal=y

#
# 硬件与文件传输（K3 有 USB 3.0 口）
#
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_openssh-sftp-server=y
