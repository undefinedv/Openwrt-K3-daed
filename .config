#
# Phicomm K3 (BCM4709C0 / bcm53xx / ARM Cortex-A9) — daed 固件种子配置
#
# 这是一份「种子 config」，只写死关键选项，其余交给 `make defconfig` 补全。
# 好处是上游改动时不会像 700 行完整 config 那样大面积失效。
#
# 改配置的正确姿势：本地 `make menuconfig` 调完后，用 `./scripts/diffconfig.sh`
# 导出差异，再把结果覆盖到本文件 —— 不要直接提交 defconfig 生成的完整 .config。
#

#
# 目标设备
#
CONFIG_TARGET_bcm53xx=y
CONFIG_TARGET_bcm53xx_generic=y
CONFIG_TARGET_bcm53xx_generic_DEVICE_phicomm_k3=y

#
# eBPF / BTF —— daed 的硬性前提，缺一不可
#
# daed 走 eBPF CO-RE，运行时必须能读到 /sys/kernel/btf/vmlinux。
# bcm53xx 不在 KERNEL_DEBUG_INFO_BTF 的 default y 列表里，所以必须手动开。
# KERNEL_DEBUG_INFO_BTF 会 select DWARVES（自动构建 pahole）。
#
CONFIG_DEVEL=y
CONFIG_BPF_TOOLCHAIN_HOST=y
CONFIG_BPF_TOOLCHAIN_HOST_PATH=""
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_DEBUG_FS=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_XDP_SOCKETS=y

#
# daed
#
# luci-app-daed 会自动带入 daed / daed-geoip / daed-geosite /
# kmod-sched-core / kmod-sched-bpf / kmod-xdp-sockets-diag / kmod-veth，
# 所以这里只需要一行。
#
CONFIG_PACKAGE_luci-app-daed=y

#
# homebox 网络测速工具箱（由 diy-part2.sh 从 jjm2473/openwrt-apps 提取）
#
CONFIG_PACKAGE_luci-app-homebox=y

#
# TCP BBR
#
# 注意：不装 luci-app-turboacc。它的 Flow Offloading 会与 daed 的 eBPF
# 转发路径冲突，Shortcut-FE 是高通平台的东西（K3 是 Broadcom，无硬件 NAT
# 加速驱动）。只有 BBR 这一项对 daed 的出站代理链路是真有用的，单独装。
#
CONFIG_PACKAGE_kmod-tcp-bbr=y

#
# LuCI
#
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_LUCI_LANG_zh_Hans=y

#
# 常用工具
#
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_htop=y
# 注意包名：没有裸的 bpftool 包，只有 -minimal（默认变体）和 -full，
# 两者都 PROVIDES:=bpftool。写 CONFIG_PACKAGE_bpftool=y 会被 defconfig 静默丢弃。
# minimal 已足够 dump BTF 排查 daed；-full 多的是 JIT 反汇编，还要拖 libbfd/libopcodes。
CONFIG_PACKAGE_bpftool-minimal=y
